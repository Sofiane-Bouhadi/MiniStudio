*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Azure
*.azurePubxml
*.pubxml
*.publishsettings

# MSBuild
*.tlog

# Others
*.pdb
*.cache
*.dbmdl
*.bak
*.tmp
*.svclog
